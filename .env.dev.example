# ============================================================
# COUNT Automation Framework - DEV Environment Configuration
# ============================================================
# Copy this file to .env.dev and fill in your values.
# NEVER commit credentials to version control.
# ============================================================

# ---- Target Environment ----
BASE_URL=https://dev-app.getcount.com
WORKSPACE_NAME=Playwright AJ

# ---- DEV Admin Portal Credentials ----
DEV_ADMIN_EMAIL=your-dev-admin@getcount.com
DEV_ADMIN_PASSWORD=your-dev-password

# ---- Gmail OTP Auto-fill ----
# Generate an App Password at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification enabled on the Google account
# Also enable IMAP: Gmail > Settings > Forwarding and POP/IMAP > Enable IMAP
GMAIL_APP_PASSWORD=

# ---- Employee Portal Credentials ----
EMPLOYEE_EMAIL=your-employee@company.com
EMPLOYEE_PASSWORD=your-employee-password

# ---- Test Data ----
TEST_FIRST_NAME=TestByAjay
TEST_LAST_NAME=AutomationByAjay
TEST_EMAIL_DOMAIN=company.com

# ---- Browser Configuration ----
BROWSER=chromium
HEADLESS=false

# ---- Reporting ----
REPORTER=html

# ---- CI/CD ----
CI=false
RETRIES=0
WORKERS=1
