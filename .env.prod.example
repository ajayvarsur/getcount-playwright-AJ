# ============================================================
# COUNT Automation Framework - PRODUCTION Environment Configuration
# ============================================================
# Copy this file to .env.prod and fill in your values.
# NEVER commit credentials to version control.
# ============================================================

# ---- Target Environment ----
BASE_URL=https://app.getcount.com
WORKSPACE_NAME=Playwright AJ PRO

# ---- PRODUCTION Admin Portal Credentials ----
PROD_ADMIN_EMAIL=your-prod-admin@getcount.com
PROD_ADMIN_PASSWORD=your-prod-password

# ---- Gmail OTP Auto-fill ----
# Generate an App Password at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification enabled on the Google account
# Also enable IMAP: Gmail > Settings > Forwarding and POP/IMAP > Enable IMAP
GMAIL_APP_PASSWORD=

# ---- Employee Portal Credentials ----
EMPLOYEE_EMAIL=your-employee@company.com
EMPLOYEE_PASSWORD=your-employee-password

# ---- Test Data ----
TEST_FIRST_NAME=TestByAjay
TEST_LAST_NAME=AutomationByAjay
TEST_EMAIL_DOMAIN=company.com

# ---- Browser Configuration ----
BROWSER=chromium
HEADLESS=false

# ---- Reporting ----
REPORTER=html

# ---- CI/CD ----
CI=false
RETRIES=2
WORKERS=1
